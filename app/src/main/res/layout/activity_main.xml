<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Header Fisso (Non scorre) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorPrimary"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="?attr/colorOnPrimary"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Letture -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/title_readings"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textColor="?attr/colorPrimary"
                        android:layout_marginBottom="12dp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:hint="@string/label_month_one_short"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputReadingMonthOne"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionNext"
                                android:maxLines="1"
                                android:autofillHints="none" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/label_month_two_short"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputReadingMonthTwo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionDone"
                                android:maxLines="1"
                                android:autofillHints="none" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card Dati Tariffa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="1dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp"
                        android:baselineAligned="false">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_component"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/textMonthOneHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/label_month_one_short"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOutline" />

                        <TextView
                            android:id="@+id/textMonthTwoHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/label_month_two_short"
                            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                            android:textColor="?attr/colorOutline" />
                    </LinearLayout>

                    <!-- Row: Corrispettivo Index -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_index_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceIndex"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceIndexMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- Contributo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_contributo_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceContributo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceContributoMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- Dispacciamento -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_dispacciamento_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceDispacciamento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceDispacciamentoMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- Trasporto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_trasporto_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceTrasporto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceTrasportoMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- ASOS -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_oneri_asos_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceOneriAsos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceOneriAsosMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- ARIM -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_oneri_arim_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceOneriArim"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceOneriArimMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- Imposte -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_imposte_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceImposte"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceImposteMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_three"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- Perdite % -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_perdite_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputLossesPercent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_percent"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputLossesPercentMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_percent"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- IVA % -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_iva_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputVatPercent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_percent"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputVatPercentMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_percent"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" />

                    <!-- Fissa -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:text="@string/label_fissa_short"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:layout_gravity="center_vertical" />
                        <EditText
                            android:id="@+id/inputPriceFissa"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_two"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                        <EditText
                            android:id="@+id/inputPriceFissaMonthTwo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:textSize="14sp"
                            android:background="@null"
                            android:gravity="center"
                            android:padding="10dp"
                            android:hint="@string/hint_decimal_two"
                            android:autofillHints="none"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCopyMonthOneToMonthTwo"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/button_copy_month_one_to_month_two"
                app:icon="@drawable/ic_copy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSavePrices"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/button_save_prices"
                app:icon="@drawable/ic_save" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCalculate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:paddingVertical="12dp"
                android:text="@string/button_calculate"
                android:textSize="16sp"
                app:icon="@drawable/ic_calculate" />

            <!-- Card Risultati -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardElevation="4dp"
                app:contentPadding="16dp"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textResultTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text=""
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorSurfaceVariant" android:layout_marginVertical="16dp"/>

                    <TextView
                        android:id="@+id/textResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/result_placeholder"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
